{
  "name": "military-info",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Modern military and defense news aggregator using NewsAPI",
  "author": "Alfani Fathurrahman",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:safety": "node --test tests/repository-safety.test.mjs tests/config-hardening.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run test:safety && npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "axios": "1.21.1",
    "fast-xml-parser": "5.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
